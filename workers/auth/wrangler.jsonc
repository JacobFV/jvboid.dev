// The site's login gate. Deployed on its own with `npx wrangler deploy` from
// this directory; Vercel never builds it. It is the only thing that knows the
// password, and the only thing that can disable login — see src/index.ts, and
// README.md for the one-time setup.
{
  "name": "jvboid-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Same arrangement as workers/contact: no destination_address, so the
  // Worker may send to any verified Email Routing destination and the
  // TO_ADDRESS secret picks which.
  "send_email": [{ "name": "SEND_EMAIL" }],
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "LoginGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginGate"] }],
  // The kill switch. `login:enabled` in this namespace is the one control
  // Jacob flips by hand in the dashboard after a lockout. Replace the id
  // with the one `wrangler kv namespace create SWITCH` prints.
  "kv_namespaces": [{ "binding": "SWITCH", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    "FROM_ADDRESS": "contact@jvboid.dev"
  },
  "observability": { "enabled": true }
}
